# Optional legacy migration reference. New installs use browser setup and require no .env file.
# Never commit a populated copy. Use npm start for live mode or npm start -- --demo for fixtures.
MODE=demo
BASE_URL=http://localhost:3000
PORT=3000
# Live mode requires HTTPS except for localhost. Server binds loopback in both modes.
# Migration only: retain the original key for existing databases. New installs generate .data/master.key.
ENCRYPTION_KEY=
SERVICE_APP_ID=
SERVICE_APP_CLIENT_ID=
SERVICE_APP_CLIENT_SECRET=
PROVIDER_INTEGRATION_CLIENT_ID=
PROVIDER_INTEGRATION_CLIENT_SECRET=
# Legacy identity pin. New installs pin the first verified developer during provider OAuth.
PROVIDER_WEBEX_PERSON_ID=
CUSTOMER_INTEGRATION_CLIENT_ID=
CUSTOMER_INTEGRATION_CLIENT_SECRET=
# Optional lifecycle webhooks require a publicly reachable HTTPS BASE_URL.
WEBHOOK_SECRET=
