# Optional legacy migration only. New installs use the UI and need no .env file.
MODE=live
BASE_URL=http://localhost:3000
PORT=3000
# Keep the original encryption key when migrating an existing database.
ENCRYPTION_KEY=
SERVICE_APP_ID=
SERVICE_APP_CLIENT_ID=
SERVICE_APP_CLIENT_SECRET=
# Never put a PAT here. Connect it through Developer Access for the current session.
